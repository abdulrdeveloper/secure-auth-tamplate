PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SAMESITE=lax
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clavis
ACCESS_TOKEN_SECRET=generate_with_node_crypto_randomBytes_64
REFRESH_TOKEN_SECRET=generate_a_different_value_with_node_crypto_randomBytes_64
RESEND_API_KEY=your_resend_api_key
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
EMAIL_FROM=noreply@yourdomain.com
APP_NAME=Clavis

# Generate RSA keys -> pnpm generate:keys 
OIDC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OIDC_KEY_ID=clavis-key-v1
ISSUER_URL=http://localhost:3000
